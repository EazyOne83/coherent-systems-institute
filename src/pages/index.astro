---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <section class="max-w-5xl mx-auto py-32 px-6">
    <h1 class="text-6xl font-extrabold text-white">
      Coherent Consciousness Framework
    </h1>

    <p class="mt-4 text-2xl text-gray-400 max-w-3xl">
      A unified scientific model describing coherence, structure, and functional dynamics
      within conscious systems.
    </p>

    <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6">
      <a href="/introduction" class="p-6 bg-gray-800 hover:bg-gray-700 rounded-xl text-white">
        <h2 class="text-xl font-semibold">Introduction</h2>
        <p class="text-gray-400 mt-2">Core principles and definitions.</p>
      </a>

      <a href="/research-objective" class="p-6 bg-gray-800 hover:bg-gray-700 rounded-xl text-white">
        <h2 class="text-xl font-semibold">Research Objective</h2>
        <p class="text-gray-400 mt-2">Formal goals and scientific direction.</p>
      </a>

      <a href="/institute-overview" class="p-6 bg-gray-800 hover:bg-gray-700 rounded-xl text-white">
        <h2 class="text-xl font-semibold">Institute Overview</h2>
        <p class="text-gray-400 mt-2">Structure, mission, and scope.</p>
      </a>
    </div>
  </section>
</BaseLayout>