---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Coherent Systems Research Institute">
  <section class="relative overflow-hidden">

    <!-- BACKGROUND LAYERS -->
    <div class="absolute inset-0 bg-gradient-to-b from-gray-950 to-gray-900"></div>
    <div class="absolute inset-0 opacity-[0.07] bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.15)_0%,rgba(0,0,0,0)_70%)]"></div>
    <div class="absolute inset-0 opacity-[0.05] bg-[linear-gradient(90deg,rgba(255,255,255,0.08)_1px,transparent_1px)] bg-[length:60px_60px]"></div>
    <div class="absolute inset-0 opacity-[0.05] bg-[linear-gradient(0deg,rgba(255,255,255,0.08)_1px,transparent_1px)] bg-[length:60px_60px]"></div>

    <!-- HERO -->
    <div class="relative max-w-6xl mx-auto px-6 pt-40 pb-32 text-center">
      <h1 class="text-6xl md:text-7xl font-extrabold tracking-tight text-white">
        Coherent Consciousness Framework
      </h1>

      <p class="mt-8 text-xl md:text-2xl text-gray-300 max-w-3xl mx-auto leading-relaxed">
        A formal scientific architecture describing coherence, structure, and functional dynamics
        within conscious systems.
      </p>
    </div>

    <!-- FEATURE GRID -->
    <div class="relative max-w-6xl mx-auto px-6 pb-32 grid grid-cols-1 md:grid-cols-3 gap-10">

      <a href="/introduction" class="group p-10 bg-gray-900/60 backdrop-blur-sm border border-gray-800 rounded-xl transition-all hover:border-gray-600 hover:bg-gray-900/80">
        <h2 class="text-2xl font-semibold text-white group-hover:text-blue-300">
          Introduction
        </h2>
        <p class="text-gray-400 mt-4 text-lg">
          Core principles, definitions, and foundational concepts.
        </p>
      </a>

      <a href="/research-objective" class="group p-10 bg-gray-900/60 backdrop-blur-sm border border-gray-800 rounded-xl transition-all hover:border-gray-600 hover:bg-gray-900/80">
        <h2 class="text-2xl font-semibold text-white group-hover:text-blue-300">
          Research Objective
        </h2>
        <p class="text-gray-400 mt-4 text-lg">
          Formal goals, scientific direction, and methodology.
        </p>
      </a>

      <a href="/institute-overview" class="group p-10 bg-gray-900/60 backdrop-blur-sm border border-gray-800 rounded-xl transition-all hover:border-gray-600 hover:bg-gray-900/80">
        <h2 class="text-2xl font-semibold text-white group-hover:text-blue-300">
          Institute Overview
        </h2>
        <p class="text-gray-400 mt-4 text-lg">
          Structure, mission, and operational scope.
        </p>
      </a>

    </div>

  </section>
</BaseLayout>