---
const { title = "Coherent Systems Research Institute" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
  </head>

  <body class="bg-gray-900 text-gray-100 min-h-screen flex flex-col">

    <!-- Header -->
    <header class="bg-gray-800 border-b border-gray-700">
      <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
        <h1 class="text-2xl font-bold text-gray-100">CSRI</h1>

        <nav class="space-x-6 text-lg">
          <a href="/" class="text-gray-300 hover:text-white">Home</a>
          <a href="/introduction" class="text-gray-300 hover:text-white">Introduction</a>
          <a href="/research-objective" class="text-gray-300 hover:text-white">Research Objective</a>
          <a href="/institute-overview" class="text-gray-300 hover:text-white">Institute Overview</a>
        </nav>
      </div>
    </header>

    <!-- Main content -->
    <main class="flex-1 max-w-6xl mx-auto px-6 py-10">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-gray-900 text-gray-300 py-6 mt-10">
      <div class="max-w-6xl mx-auto px-6 text-center">
        <p class="text-sm">© 2026 Coherent Systems Research Institute</p>
      </div>
    </footer>

  </body>
</html>