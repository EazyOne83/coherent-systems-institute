---
const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <link rel="stylesheet" href="/styles/global.css" />
  </head>
  <body class="bg-gray-50 text-gray-900">
    <main class="max-w-3xl mx-auto p-6">
      <slot />
    </main>
  </body>
</html>